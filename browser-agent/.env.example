# Скопіювати у .env і заповнити (файл .env у git не потрапляє).
BROWSER_AGENT_SECRET=ЗМІНИТИ_НА_ДОВГИЙ_РАНДОМ   # спільний секрет; воронка шле у заголовку X-Agent-Secret
ANTHROPIC_API_KEY=                              # мозок ШІ-агента (Claude)
AGENT_MODEL=claude-sonnet-4-6
BROWSER_HEADLESS=1
BROWSER_NAV_TIMEOUT_MS=30000
PORT=8091
