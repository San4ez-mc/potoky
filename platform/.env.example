# ============================================================
# DATABASE
# ============================================================
DATABASE_URL="postgresql://platform_user:password@localhost:5432/platform_db"

# ============================================================
# REDIS (Bull queue)
# ============================================================
REDIS_URL="redis://localhost:6379"

# ============================================================
# API SERVER
# ============================================================
PORT=3000
NODE_ENV=development
API_SECRET=                        # випадковий рядок 32+ символи

# ============================================================
# ADMIN PANEL AUTH
# ============================================================
ADMIN_PASSWORD_HASH=               # bcrypt hash пароля адміна
SESSION_SECRET=                    # випадковий рядок 64+ символи

# ============================================================
# ANTHROPIC / CLAUDE
# ============================================================
ANTHROPIC_API_KEY=                 # console.anthropic.com → API Keys
CLAUDE_MODEL=claude-haiku-4-5     # або claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TIMEOUT_MS=30000

# ============================================================
# TELEGRAM (finance-course bot)
# ============================================================
TELEGRAM_BOT_TOKEN=                # BotFather → /newbot
TELEGRAM_WEBHOOK_SECRET=           # секретний токен для перевірки вебхуку
TELEGRAM_WEBHOOK_URL=              # https://yourdomain.com/webhook/telegram

# ============================================================
# GOOGLE / APPS SCRIPT
# ============================================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=        # PEM private key (з \n)
GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID=

# ============================================================
# FILE STORAGE
# ============================================================
FILES_BASE_PATH=/data/files        # абсолютний шлях на диску

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info                     # error | warn | info | debug
